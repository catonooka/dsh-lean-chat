{
  "manifest_version": 3,
  "name": "dsh-lean-chat Chrome bridge",
  "version": "0.2.0",
  "description": "Runs dsh-lean-chat's web searches and browser steps inside this browser, with your cookies — searches fetch silently, browser steps drive a real tab.",
  "minimum_chrome_version": "116",
  "permissions": ["cookies", "storage", "alarms", "debugger"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.google.com/*",
    "https://www.bing.com/*",
    "https://duckduckgo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
