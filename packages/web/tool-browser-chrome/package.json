{
  "name": "@deepseek-ai/dsh-tool-browser-chrome",
  "description": "Model-facing browser tool that drives the user's own Chrome through the companion extension bridge — read-only steps first, compact capped observations",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catonooka/dsh-lean-chat.git",
    "directory": "packages/web/tool-browser-chrome"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-web-search-chrome": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-web-search-chrome": "workspace:^"
  }
}
